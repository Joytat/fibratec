<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Support\Facades\Http;
use Illuminate\Support\Facades\Log;

class XuiController extends Controller
{
    private string $xuiServer;

    public function __construct()
    {
        // Leer desde .env (ej: XUI_SERVER=http://30.255.255.13)
        $this->xuiServer = rtrim(env('XUI_SERVER', 'http://30.255.255.13'), '/');
    }

    /**
     * Intento de login: consulta user_info en la API XUI/Xtream.
     */
    public function login(Request $request)
    {
        $request->validate([
            'username' => ['required', 'string'],
            'password' => ['required', 'string'],
        ]);

        $username = $request->username;
        $password = $request->password;

        try {
            $response = Http::timeout(10)->get($this->xuiServer . '/player_api.php', [
                'username' => $username,
                'password' => $password,
                // Algunos servidores usan get_user_info o get_account_info
                'action' => 'get_user_info',
            ]);

            if (!$response->successful()) {
                return response()->json([
                    'success' => false,
                    'message' => 'No se pudo conectar con el servidor IPTV (login).'
                ], 502);
            }

            $data = $response->json();

            if (!isset($data['user_info']) || (($data['user_info']['auth'] ?? 0) != 1)) {
                return response()->json([
                    'success' => false,
                    'message' => 'Usuario o contraseña incorrectos.'
                ], 401);
            }

            return response()->json([
                'success' => true,
                'message' => 'Conectado correctamente.',
                'user' => $data['user_info'],
            ]);

        } catch (\Throwable $e) {
            Log::error('XUI login error: ' . $e->getMessage());
            return response()->json([
                'success' => false,
                'message' => 'No se pudo establecer conexión con el servidor IPTV.',
            ], 500);
        }
    }

    /**
     * Obtener categorías en vivo.
     */
    public function liveCategories(Request $request)
    {
        $request->validate([
            'username' => ['required', 'string'],
            'password' => ['required', 'string'],
        ]);

        try {
            $response = Http::timeout(15)->get($this->xuiServer . '/player_api.php', [
                'username' => $request->username,
                'password' => $request->password,
                'action' => 'get_live_categories',
            ]);

            if (!$response->successful()) {
                return response()->json([
                    'success' => false,
                    'message' => 'No se pudieron obtener las categorías.'
                ], 502);
            }

            return response()->json([
                'success' => true,
                'categories' => $response->json(),
            ]);

        } catch (\Throwable $e) {
            Log::error('XUI liveCategories error: ' . $e->getMessage());
            return response()->json([
                'success' => false,
                'message' => 'Error consultando las categorías.'
            ], 500);
        }
    }

    /**
     * Obtener lista de canales en vivo.
     */
    public function liveStreams(Request $request)
    {
        $request->validate([
            'username' => ['required', 'string'],
            'password' => ['required', 'string'],
        ]);

        try {
            $response = Http::timeout(20)->get($this->xuiServer . '/player_api.php', [
                'username' => $request->username,
                'password' => $request->password,
                'action' => 'get_live_streams',
            ]);

            if (!$response->successful()) {
                return response()->json([
                    'success' => false,
                    'message' => 'No se pudieron obtener los canales.'
                ], 502);
            }

            return response()->json([
                'success' => true,
                'channels' => $response->json(),
            ]);

        } catch (\Throwable $e) {
            Log::error('XUI liveStreams error: ' . $e->getMessage());
            return response()->json([
                'success' => false,
                'message' => 'Error consultando los canales.'
            ], 500);
        }
    }

    /**
     * Obtener una URL reproducible para un canal específico.
     * Devuelve 'url' que idealmente apunta a un .m3u8 o a un proxy local para evitar CORS.
     */
    public function streamUrl(Request $request)
    {
        $request->validate([
            'username' => ['required', 'string'],
            'password' => ['required', 'string'],
            'stream_id' => ['required'],
        ]);

        $username = $request->username;
        $password = $request->password;
        $streamIdRaw = $request->stream_id;
        $streamId = is_numeric($streamIdRaw) ? (int) $streamIdRaw : $streamIdRaw; // some XUI use string ids

        try {
            // Primero pedimos la lista de canales
            $response = Http::timeout(20)->get($this->xuiServer . '/player_api.php', [
                'username' => $username,
                'password' => $password,
                'action' => 'get_live_streams',
            ]);

            if (!$response->successful()) {
                return response()->json([
                    'success' => false,
                    'message' => 'No se pudieron consultar los canales de XUI.'
                ], 502);
            }

            $channels = $response->json();
            if (!is_array($channels)) {
                return response()->json([
                    'success' => false,
                    'message' => 'XUI no devolvió una lista válida de canales.'
                ], 502);
            }

            // Buscar canal por stream_id, id o num (flexible)
            $channel = collect($channels)->first(function ($item) use ($streamId) {
                if (!is_array($item)) return false;
                // posibles claves
                $candidates = [
                    $item['stream_id'] ?? null,
                    $item['id'] ?? null,
                    $item['num'] ?? null,
                ];
                foreach ($candidates as $cand) {
                    if ($cand === null) continue;
                    if (is_numeric($cand) && is_numeric($streamId) && (int)$cand === (int)$streamId) return true;
                    if ((string)$cand === (string)$streamId) return true;
                }
                return false;
            });

            if (!$channel) {
                return response()->json([
                    'success' => false,
                    'message' => 'No se encontró el canal en XUI.',
                    'stream_id' => $streamIdRaw,
                ], 404);
            }

            // 1) Si la API ya devuelve una URL directa, úsala (y proxifícala para evitar CORS)
            $possibleKeys = ['stream_url', 'url', 'stream_source', 'stream_uri', 'playlist_url'];
            foreach ($possibleKeys as $k) {
                if (!empty($channel[$k]) && filter_var($channel[$k], FILTER_VALIDATE_URL)) {
                    $orig = $channel[$k];
                    $proxy = url('/proxy') . '?url=' . urlencode($orig);
                    return response()->json([
                        'success' => true,
                        'url' => $proxy,
                        'original' => $orig,
                        'note' => 'URL proxificada para evitar CORS.'
                    ]);
                }
            }

            // 2) Intentar construir URLs típicas Xtream/XUI
            $candidates = [
                "{$this->xuiServer}/live/{$username}/{$password}/{$streamId}.m3u8",
                "{$this->xuiServer}/live/{$username}/{$password}/{$streamId}.ts",
                "{$this->xuiServer}/get.php?username={$username}&password={$password}&type=m3u",
                // otras plantillas que algunos proveedores usan:
                "{$this->xuiServer}/get.php?username={$username}&password={$password}&type=mpegts&stream={$streamId}",
            ];

            foreach ($candidates as $candidate) {
                try {
                    // Algunos servidores no responden a HEAD; intentamos HEAD y si falla hacemos GET rápido.
                    $ok = false;
                    try {
                        $head = Http::timeout(6)->head($candidate);
                        $ok = $head->ok();
                    } catch (\Throwable $e) {
                        // intentar GET con tiempo pequeño
                        $small = Http::timeout(6)->get($candidate);
                        $ok = $small->ok();
                    }

                    if ($ok) {
                        // devolvemos la URL proxificada para evitar CORS
                        return response()->json([
                            'success' => true,
                            'url' => url('/proxy') . '?url=' . urlencode($candidate),
                            'original' => $candidate,
                            'note' => 'URL construida y proxificada.'
                        ]);
                    }
                } catch (\Throwable $e) {
                    // ignora y prueba el siguiente candidato
                    Log::warning("XUI candidate check failed for {$candidate}: " . $e->getMessage());
                }
            }

            // 3) Fallback: devolver la playlist M3U (get.php?type=m3u) para que el cliente la parseé o para debug
            $m3uUrl = "{$this->xuiServer}/get.php?username={$username}&password={$password}&type=m3u";
            return response()->json([
                'success' => true,
                'url' => url('/proxy') . '?url=' . urlencode($m3uUrl),
                'original' => $m3uUrl,
                'note' => 'Se devuelve la M3U como fallback (proxificada).'
            ]);

        } catch (\Throwable $e) {
            Log::error('XUI streamUrl error: ' . $e->getMessage());
            return response()->json([
                'success' => false,
                'message' => 'Error consultando XUI.',
                'error' => $e->getMessage(),
            ], 500);
        }
    }

    /**
     * Proxy simple para evitar CORS y devolver contenido remoto (m3u8, ts, etc).
     * Uso: /proxy?url={url_remota}
     * NOTA: En producción debes mejorar validación, caching y límites.
     */
    public function proxy(Request $request)
    {
        $url = $request->query('url');
        if (!$url || !filter_var($url, FILTER_VALIDATE_URL)) {
            return response('URL inválida', 400);
        }

        try {
            // Obtener el contenido remoto (no ideal para streams de gran tamaño en producción,
            // pero suficiente para pruebas). Ajusta timeouts según necesites.
            $resp = Http::withOptions(['stream' => false, 'verify' => false])->timeout(30)->get($url);

            if (!$resp->successful()) {
                return response('Error upstream', 502);
            }

            $contentType = $resp->header('Content-Type', 'application/octet-stream');

            // Responder con cabecera CORS para que hls.js / el navegador puedan leer.
            $headers = [
                'Content-Type' => $contentType,
                'Access-Control-Allow-Origin' => '*',
                'Access-Control-Allow-Methods' => 'GET, OPTIONS',
                'Cache-Control' => 'no-cache',
            ];

            return response($resp->body(), 200, $headers);

        } catch (\Throwable $e) {
            Log::error('Proxy error: ' . $e->getMessage());
            return response('Error proxy', 500);
        }
    }
}